# API origin (leave empty for same-origin or when using Vite dev proxy / MSW mocks)
VITE_API_BASE_URL=

# Serve API responses from local MSW mocks in development ("true" or "false")
VITE_USE_MOCKS=true

# Optional Vite dev server proxy target for /api (leave empty when VITE_USE_MOCKS=true)
VITE_DEV_PROXY_TARGET=
