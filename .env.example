# Copy this file to .env and change what you need. Never commit .env.

# API origin. Leave empty to use the same origin as the web app.
VITE_API_BASE_URL=

# "true" serves every API call from the in-browser mocks (MSW). Development only: it is ignored in production builds.
VITE_USE_MOCKS=true

# Dev-server proxy target for /api when the real API runs elsewhere (leave unset when using mocks).
VITE_DEV_PROXY_TARGET=
